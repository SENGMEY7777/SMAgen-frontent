# SMAgen Frontend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Only .env.example is tracked.

# ─── Vite build-time variables ───────────────────────────────────────────────
# Use /api/v1 when the API is proxied by Nginx (Docker / production).
# Use http://localhost:8082/api/v1 for direct Vite dev-server access.
VITE_API_BASE_URL=/api/v1

# Local backend used by the Vite development proxy (npm run dev only).
VITE_API_PROXY_TARGET=http://localhost:8082

# ─── Docker Compose runtime variables ────────────────────────────────────────
# Internal URL that the Nginx container proxies API requests to.
API_UPSTREAM=http://kairo-api:5000

# Host port for the Nginx frontend container.
FRONTEND_PORT=5173

# Host port for direct backend access (health checks / debugging).
BACKEND_PORT=8082
