# SMAgen Frontend Environment Configuration
# Use /api/v1 for an external backend URL; the app also normalizes a bare origin.
VITE_API_BASE_URL=/api/v1
# Local backend used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:8082

# Docker runtime configuration
# Backend reachable through the internal Docker Compose network.
API_UPSTREAM=http://kairo-api:5000
# Host port exposed for direct backend health checks.
BACKEND_PORT=8082
# Optional host port for the frontend container.
FRONTEND_PORT=8080
